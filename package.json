{
  "name": "campaign-iq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace @campaign-iq/web",
    "db:generate": "npm run db:generate --workspace @campaign-iq/database",
    "db:migrate": "npm run db:migrate --workspace @campaign-iq/database",
    "db:seed": "npm run db:seed --workspace @campaign-iq/api"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
